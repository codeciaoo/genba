{
  "name": "genba-mobile",
  "version": "0.0.1",
  "description": "GENBA GEAR Mobile App - AIポケット事務員",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern='__tests__/.*\\.test\\.(ts|tsx)$'",
    "test:integration": "jest --testPathPattern='__tests__/integration'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test e2e/flows"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-av": "~14.0.0",
    "expo-location": "~17.0.0",
    "expo-notifications": "~0.28.0",
    "expo-print": "~13.0.0",
    "expo-sharing": "~12.0.0",
    "react": "18.3.1",
    "react-native": "0.83.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.19.0",
    "@nozbe/watermelondb": "^0.27.0",
    "@supabase/supabase-js": "^2.45.0",
    "openai": "^4.70.0",
    "nativewind": "^4.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@biomejs/biome": "^1.9.0",
    "@testing-library/react-native": "^12.7.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "msw": "^2.4.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
